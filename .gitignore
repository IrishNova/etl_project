# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environment
.venv/
venv/

# Environment / secrets
.env
*.local

# Data (keep directories, ignore contents)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Hold-out truth — answer keys + data generators. Never committed, never read
# during the build; used only for a final honest validation.
_answer_key/

# OS / editor
.DS_Store
.idea/
.vscode/
