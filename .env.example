# Copy to `.env` and fill in real values. Never commit the real .env.

# --- Postgres (read by docker-compose AND the app) ---
POSTGRES_USER=etl
POSTGRES_PASSWORD=change_me
POSTGRES_DB=etl_warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- SQLAlchemy URL the app reads (12-factor single source of connection) ---
# Host dev: host=localhost, port=5433. In Docker: host=db, port=5432.
DATABASE_URL=postgresql+psycopg2://etl:change_me@localhost:5433/etl_warehouse
